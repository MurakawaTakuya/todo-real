rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedWriter(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (
          request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true
        );
    }

    function isAllowedImage() {
      return request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches(
          '^image/(jpeg|png|webp)$'
        );
    }

    match /post/{userId}/{objectId} {
      allow read: if request.auth != null;
      allow create: if isVerifiedWriter(userId) && isAllowedImage();
      allow update, delete: if false;
    }

    match /post/{legacyObjectId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
